# Database Configuration
DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE"

# Last.fm API Credentials (RECOMMENDED - Simpler than Spotify!)
# Get your API key at: https://www.last.fm/api/account/create
LASTFM_API_KEY="your_lastfm_api_key_here"
LASTFM_API_SECRET="your_lastfm_shared_secret_here"

# Last.fm Feature Flag (Optional - defaults to true)
ENABLE_LASTFM_VERIFICATION="true"

# Legacy Spotify API Credentials (Optional - can use Last.fm instead)
# Get these at: https://developer.spotify.com/dashboard/applications
SPOTIFY_CLIENT_ID="your_spotify_client_id"
SPOTIFY_CLIENT_SECRET="your_spotify_client_secret"

# NextAuth Configuration (Legacy - only needed if using Spotify OAuth)
NEXTAUTH_URL="https://your-deployment-url.example.com"
NEXTAUTH_SECRET="generate_with_openssl_rand"

# Spotify Feature Flag (Legacy)
ENABLE_SPOTIFY_VERIFICATION="false"
NEXT_PUBLIC_ENABLE_SPOTIFY_VERIFICATION="false"

# Application Configuration
TICKET_REDIRECT_URL="https://your-ticket-redirect.example.com"
ADMIN_EMAIL="admin@your-domain.example"
NODE_ENV="development"
